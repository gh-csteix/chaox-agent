# Copy to .env and generate a strong random bearer token:
#   openssl rand -hex 32   (or: npm run token)
CHAOX_AUTH_TOKEN=replace-with-a-random-64-char-hex-token

# Optional privilege separation (keep CHAOX_AUTH_TOKEN unset once migrated):
# - CHAOX_SYNC_TOKEN: iOS apps only (/sync/* + PUT /preferences; 403 on /mcp)
# - CHAOX_MCP_TOKEN: AI clients only (/mcp + GET /preferences; 403 on /sync/*)
# - CHAOX_MCP_READONLY_TOKEN: Read-only AI clients (forces readonly on /mcp)
# CHAOX_SYNC_TOKEN=
# CHAOX_MCP_TOKEN=
# CHAOX_MCP_READONLY_TOKEN=

# Host port / listen interface (keep 127.0.0.1 behind Caddy, Tailscale, or Cloudflare Tunnel)
BIND_ADDR=127.0.0.1
PORT=8787

# Optional security & runtime overrides
# CHAOX_ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com
# CHAOX_ALLOW_MCP_PREFERENCES_WRITE=true
# CHAOX_TRUST_PROXY=false
# CHAOX_DB_PATH=/data/chaox-agent.sqlite
# CHAOX_SERVER_NAME=chaox-agent-server
# CHAOX_MAX_BODY_BYTES=20971520
