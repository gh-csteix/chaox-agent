# Copy to .env and generate a strong random bearer token:
#   openssl rand -hex 32   (or: npm run token)
CHAOX_AUTH_TOKEN=replace-with-a-random-64-char-hex-token

# Host port / listen interface (keep 127.0.0.1 behind Caddy, Tailscale, or Cloudflare Tunnel)
BIND_ADDR=127.0.0.1
PORT=8787

# Optional overrides
# CHAOX_DB_PATH=/data/chaox-agent.sqlite
# CHAOX_SERVER_NAME=chaox-agent-server
# CHAOX_MAX_BODY_BYTES=20971520
