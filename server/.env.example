# Copy to .env and fill in two separate random 64-char hex bearer tokens:
#   npm run token   (or: openssl rand -hex 32)
# Both tokens are intentionally left empty so an unedited .env fails closed (HTTP 401).
# - CHAOX_SYNC_TOKEN: iOS apps only (SX/BX/CSTEIX /sync/* + PUT /preferences; 403 on /mcp)
# - CHAOX_MCP_TOKEN: AI MCP clients only (/mcp + GET /preferences; 403 on /sync/*)
CHAOX_SYNC_TOKEN=
CHAOX_MCP_TOKEN=

# Optional read-only MCP token (forces read-only mode on /mcp) or legacy single-token fallback:
# CHAOX_MCP_READONLY_TOKEN=
# CHAOX_AUTH_TOKEN=

# Host port / listen interface (keep 127.0.0.1 behind Caddy, Tailscale, or Cloudflare Tunnel)
BIND_ADDR=127.0.0.1
PORT=8787

# Optional security & runtime overrides
# Comma-separated browser Origin allowlist for web-based MCP clients:
# CHAOX_ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com
# Set false to block AI MCP clients from writing shared cross-app preferences via chaox_update_preferences (default true):
# CHAOX_ALLOW_MCP_PREFERENCES_WRITE=false
# Set true behind a trusted reverse proxy (Caddy, Nginx, Cloudflare Tunnel) so auth rate limiting reads X-Forwarded-For
# (server/docker-compose.yml defaults this to true; standalone Node defaults to false):
# CHAOX_TRUST_PROXY=false
# Maximum request body size in bytes for /sync/* payloads (default 20971520 = 20 MiB; /mcp & /preferences are capped at 2 MiB):
# CHAOX_MAX_BODY_BYTES=20971520
# SQLite database file path and server identifier:
# CHAOX_DB_PATH=/data/chaox-agent.sqlite
# CHAOX_SERVER_NAME=chaox-agent-server
